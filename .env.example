# Groq API key for the "Ask My Portfolio" AI assistant.
# Get your free key at https://console.groq.com
VITE_GROQ_API_KEY=your_groq_api_key_here

# Optional: If you have a backend endpoint for the assistant, use this instead.
# Leave unset to use Groq API directly from the frontend.
VITE_ASSISTANT_API_URL=

# Optional: mailto fallback is always available; set this if you wire up
# a real form backend (e.g. Formspree, a serverless function, EmailJS).
VITE_CONTACT_FORM_ENDPOINT=
